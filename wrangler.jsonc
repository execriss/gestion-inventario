{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inventario-pro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "inventario.exegestion.com",
      "custom_domain": true
    }
  ]
}
